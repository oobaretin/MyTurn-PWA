# Postgres (Neon, Vercel Postgres, etc.)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/tick (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Optional: canonical URL for kid links in SMS (defaults to Vercel production domain)
# NEXT_PUBLIC_APP_URL=https://my-turn-pwa.vercel.app
